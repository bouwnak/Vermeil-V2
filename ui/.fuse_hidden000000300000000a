const NAMES = ["Mika", "Jun", "Lia", "Kai", "Noor", "Ren", "Ivy", "Theo", "Ana", "Sam", "Inés", "Oli", "Zed", "Pia", "Maya", "Leo", "Rae", "Eda", "Tom", "Aiko", "Bea", "Cyrus", "Dani", "Elio", "Fen", "Gus", "Hana", "Ilan", "Jade", "Kofi", "Luz", "Milo"];
